<%- include('partials/page-start', { activePage: 'recepcion' }) %>
<nav class="breadcrumb" aria-label="Ubicación"><a href="/recepcion">Recepción</a><span>/</span><%= menor.folio %></nav>
<header class="page-heading"><div><span class="eyebrow">ENTRADA DEL MENOR</span><h1><%= [menor.nombres,menor.apellido_paterno,menor.apellido_materno].filter(Boolean).join(' ') %></h1><p><%= menor.folio %> · <%= menor.edad %> · <%= menor.grupo_nombre || 'Sin grupo' %></p></div><a class="btn btn-outline" href="/expedientes/<%= menor.id %>">Ver expediente</a></header>
<div class="reception-note"><span class="folio-tag"><%= fecha %></span><span>Hora actual: <strong><%= hora.slice(0,5) %></strong></span><span>Horario: <%= horario.inicio.slice(0,5) %> a <%= horario.fin.slice(0,5) %> h</span></div>
<% if (menor.alergias || menor.cuidados_especiales) { %><section class="surface-card reception-alert"><h2 class="small-section-title">Información para la recepción</h2><% if (menor.alergias) { %><p><strong>Alergias:</strong> <%= menor.alergias %></p><% } %><% if (menor.cuidados_especiales) { %><p><strong>Cuidados especiales:</strong> <%= menor.cuidados_especiales %></p><% } %></section><% } %>
<% const habilitado = horarioAbierto && !hoyRegistrado && grupoCorrecto && !!menor.grupo_id && menor.estado === 'activo' && (!menor.fecha_ingreso || menor.fecha_ingreso <= fecha) %>
<% if (!habilitado) { %><p class="warn-notice">
<% if (menor.estado === "baja") { %>El expediente está dado de baja; solo se puede consultar el historial.
<% } else if (hoyRegistrado) { %>Este menor ya tiene una entrada registrada hoy. No se puede duplicar.
<% } else if (!grupoCorrecto || !menor.grupo_id) { %>La asignación del grupo debe revisarla administración antes de registrar la entrada.
<% } else if (menor.fecha_ingreso && menor.fecha_ingreso > fecha) { %>El menor todavía no llega a su fecha de ingreso.
<% } else { %>El horario de recepción está cerrado. No se permite guardar entradas fuera de <%= horario.inicio.slice(0,5) %> a <%= horario.fin.slice(0,5) %> h.
<% } %></p><% } %>
<% if (habilitado) { %><form method="POST" action="/recepcion/<%= menor.id %>" class="record-form">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<section class="surface-card record-section"><div class="record-section-header"><span class="section-number">01</span><div><h2>Revisión física</h2><p>Revisa al menor a su llegada e indica si hay golpes, raspaduras u otras observaciones.</p></div></div>
<div class="form-grid"><div><label for="revision_fisica">Resultado de la revisión *</label><select id="revision_fisica" name="revision_fisica" required><option value="">Seleccionar resultado</option><option value="sin_lesiones">Sin lesiones visibles</option><option value="con_observaciones">Con golpes, raspaduras u observaciones</option></select></div><div class="full-field"><label for="observaciones_fisicas">Observaciones físicas</label><textarea id="observaciones_fisicas" name="observaciones_fisicas" maxlength="1000" rows="3" placeholder="Describe lo que encontraste, especialmente si marcaste observaciones."></textarea></div></div></section>
<section class="surface-card record-section"><div class="record-section-header"><span class="section-number">02</span><div><h2>Artículos personales</h2><p>Confirma qué trae el menor y señala si falta algún artículo que necesitaba.</p></div></div>
<div class="form-grid">
<% articulos.forEach(campo => { const etiqueta = ({ leche: 'Leche', panales: 'Pañales', ropa: 'Ropa de cambio', cobija: 'Cobija' })[campo] %><div><label for="<%= campo %>"><%= etiqueta %> *</label><select id="<%= campo %>" name="<%= campo %>" required><option value="">Seleccionar</option><option value="si">Sí, lo trae</option><option value="no">No, hace falta</option><option value="no_aplica">No aplica</option></select></div><% }) %>
<div><label for="otros_articulos">Otros artículos</label><input name="otros_articulos" id="otros_articulos" maxlength="255" placeholder="Ej. Medicación entregada, juguetes..."></div><div class="full-field"><label for="notas_articulos">Observaciones de artículos</label><textarea name="notas_articulos" id="notas_articulos" rows="3" maxlength="500" placeholder="Estado de los artículos, cantidades o faltantes adicionales"></textarea></div>
</div></section><div class="record-actions"><a class="btn btn-outline" href="/recepcion">Cancelar</a><button class="btn btn-primary" type="submit">Registrar entrada</button></div></form><% } %>
<section class="surface-card reception-history"><div class="section-title"><div><h2 class="small-section-title">Historial de entradas</h2><p>Últimas 15 entradas y la fecha consultada, si es distinta.</p></div><span class="count-pill"><%= historial.length %></span></div>
<% if (!historial.length) { %><p class="helper-paragraph">Aún no hay entradas registradas para este menor.</p><% } else { %><div class="reception-records">
<% historial.forEach(e => { const faltantes = articulos.filter(a => e[a] === 'no').map(a => a === 'panales' ? 'Pañales' : a.charAt(0).toUpperCase() + a.slice(1)) %>
<div class="reception-record"><div class="section-title"><h3><%= e.fecha %> · <%= String(e.hora).slice(0,5) %></h3><span class="<%= e.revision_fisica === 'sin_lesiones' ? 'text-good' : 'text-warning' %>"><%= e.revision_fisica === 'sin_lesiones' ? 'Sin lesiones visibles' : 'Con observaciones' %></span></div>
<% if (e.observaciones_fisicas) { %><p><strong>Revisión:</strong> <%= e.observaciones_fisicas %></p><% } %>
<p><strong>Artículos:</strong> <% articulos.forEach((a, i) => { %><%= ({leche:'Leche',panales:'Pañales',ropa:'Ropa',cobija:'Cobija'})[a] %>: <%= ({si:'Sí',no:'Falta',no_aplica:'No aplica'})[e[a]] %><%= i === articulos.length - 1 ? '' : ' · ' %><% }) %></p>
<% if (faltantes.length) { %><p class="text-warning">Faltantes: <%= faltantes.join(', ') %></p><% } %>
<% if (e.otros_articulos) { %><p><strong>Otros:</strong> <%= e.otros_articulos %></p><% } %>
<% if (e.notas_articulos) { %><p><strong>Notas:</strong> <%= e.notas_articulos %></p><% } %>
</div><% }) %>
</div><% } %>
</section>
<%- include('partials/page-end') %>
