<%- include('partials/page-start', { activePage: 'inicio' }) %>

<header class="home-heading">
  <div>
    <span class="page-eyebrow">PANEL PRINCIPAL</span>
    <h1>Inicio</h1>
    <p>Las áreas de la guardería, en un solo lugar.</p>
  </div>
  <div class="home-date-tag" aria-label="Fecha de hoy">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 10h18"/></svg>
    <span><%= new Intl.DateTimeFormat('es-MX', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date()) %></span>
  </div>
</header>

<section class="home-hero" aria-label="Bienvenida">
  <div class="hero-copy">
    <span class="hero-overline"><span class="hero-spark"></span> GUARDERÍA INFANTIL</span>
    <h2>Un espacio para cuidar<br>cada detalle.</h2>
    <p>Bienvenido, <strong><%= usuario.nombre %></strong>. Aquí podrás encontrar las herramientas para organizar el trabajo de la guardería.</p>
    <span class="hero-note">Cuidado, organización y atención</span>
  </div>
  <div class="hero-art" aria-hidden="true">
    <svg viewBox="0 0 390 260" fill="none" xmlns="http://www.w3.org/2000/svg" role="presentation">
      <ellipse cx="195" cy="239" rx="172" ry="14" fill="#BACFBE" fill-opacity=".35"/>
      <circle cx="316" cy="61" r="32" fill="#F5DCA0"/>
      <circle cx="316" cy="61" r="21" fill="#FCEBC2"/>
      <path d="M63 58c0-9 8-17 17-17 5 0 9 2 12 5 4-8 12-13 21-13 13 0 23 10 23 23h10c9 0 16 7 16 16 0 9-7 16-16 16H79c-9 0-16-7-16-16 0-5 2-10 6-13" fill="#fff" fill-opacity=".85"/>
      <path d="M38 202c16-45 43-66 80-66 37 0 63 25 72 66" stroke="#D7B79F" stroke-width="17" stroke-linecap="round"/>
      <path d="M52 203c13-34 35-51 66-51 30 0 52 18 62 51" stroke="#F6E3CC" stroke-width="17" stroke-linecap="round"/>
      <path d="M69 202c10-22 25-33 49-33 22 0 37 12 46 33" stroke="#C9DCD0" stroke-width="17" stroke-linecap="round"/>
      <rect x="183" y="154" width="76" height="75" rx="14" fill="#E3AF87"/>
      <rect x="190" y="161" width="62" height="61" rx="10" fill="#F5D0B2"/>
      <text x="221" y="207" text-anchor="middle" fill="#8B6252" font-family="Arial,sans-serif" font-weight="700" font-size="33">A</text>
      <rect x="266" y="179" width="65" height="50" rx="12" fill="#C8DAD3"/>
      <rect x="271" y="183" width="55" height="41" rx="9" fill="#E5F0E9"/>
      <text x="299" y="213" text-anchor="middle" fill="#4E796B" font-family="Arial,sans-serif" font-weight="700" font-size="25">B</text>
      <path d="M235 123c0-19 15-34 34-34s34 15 34 34v31h-68v-31Z" fill="#EFCB7A"/>
      <path d="M246 124c0-13 10-23 23-23s23 10 23 23v20h-46v-20Z" fill="#FAE4A4"/>
      <circle cx="269" cy="128" r="5" fill="#E5AF59"/>
      <path d="M349 225v-62" stroke="#6A9E80" stroke-width="5" stroke-linecap="round"/>
      <path d="M348 188c-26 3-30-18-15-24 10-4 18 8 15 24ZM350 207c25 0 32-18 19-26-12-7-20 5-19 26Z" fill="#8FB79A"/>
      <path d="M334 224h29l-4 16h-21l-4-16Z" fill="#D39E8C"/>
      <circle cx="41" cy="123" r="6" fill="#E2B7A3"/>
      <path d="M40 111v-8m0 38v-8m-11-11h-8m38 0h-8" stroke="#E2B7A3" stroke-width="3" stroke-linecap="round"/>
      <circle cx="345" cy="111" r="4" fill="#fff"/>
      <circle cx="171" cy="104" r="3.5" fill="#9ABAAD"/>
    </svg>
  </div>
</section>

<% if (usuario.rol === 'administrador') { %>
<section class="home-staff" aria-label="Gestión de personal">
  <div class="home-staff-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><path d="M3 20v-1c0-3 2.5-5 6-5s6 2 6 5v1M17 6a3 3 0 0 1 0 6m1 2c2.3.7 3.5 2.2 3.5 5"/></svg>
  </div>
  <div class="home-staff-copy">
    <span class="small-label">ADMINISTRACIÓN</span>
    <h3>Personal de la guardería</h3>
    <p><strong><%= personalActivo %> <%= personalActivo === 1 ? 'cuenta activa' : 'cuentas activas' %></strong> · Administra los accesos y los roles del personal.</p>
  </div>
  <a class="btn btn-primary home-staff-button" href="/usuarios">Ver personal <span aria-hidden="true">→</span></a>
</section>
<% } %>

<section class="home-modules" aria-labelledby="home-modules-title">
  <div class="modules-heading">
    <div>
      <span class="page-eyebrow">ORGANIZACIÓN</span>
      <h2 id="home-modules-title">Áreas de la guardería</h2>
      <p>Consulta los expedientes. Las demás áreas se habilitarán en los próximos sprints.</p>
    </div>
    <span class="modules-count">5 áreas</span>
  </div>
  <div class="module-grid">
    <a class="module-card module-peach" href="/expedientes">
      <div class="module-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 3v3h6V3M9 11h6M9 15h6M9 19h3"/></svg></div>
      <h3>Expedientes</h3>
      <p>Información de los niños, padres, tutores y cuidados.</p>
      <span class="module-state module-state-ready"><span></span> Disponible · Ver expedientes →</span>
    </a>
    <article class="module-card module-blue">
      <div class="module-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21V7l8-4 8 4v14M4 21h16M9 21v-7h6v7M8 10h1m6 0h1"/></svg></div>
      <h3>Grupos y recepción</h3>
      <p>Organización por edades y control de entradas.</p>
      <span class="module-state"><span></span> Próximamente</span>
    </article>
    <article class="module-card module-lilac">
      <div class="module-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M8 3v4m8-4v4M4 10h16m-12 4h3m-3 4h7"/></svg></div>
      <h3>Cuidados diarios</h3>
      <p>Actividades, alimentación y seguimiento.</p>
      <span class="module-state"><span></span> Próximamente</span>
    </article>
    <article class="module-card module-yellow">
      <div class="module-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="4"/><path d="M12 8v8M8 12h8"/></svg></div>
      <h3>Enfermería</h3>
      <p>Control de salud, revisiones y medicamentos.</p>
      <span class="module-state"><span></span> Próximamente</span>
    </article>
    <article class="module-card module-green">
      <div class="module-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h12m-5-5 5 5-5 5M19 4h2v16h-2"/></svg></div>
      <h3>Salidas y movimientos</h3>
      <p>Entrega de menores, bajas y reinscripciones.</p>
      <span class="module-state"><span></span> Próximamente</span>
    </article>
  </div>
</section>
<%- include('partials/page-end') %>
