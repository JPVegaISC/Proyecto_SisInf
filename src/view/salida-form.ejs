<%- include('partials/page-start', { activePage: 'salidas' }) %>
<nav class="breadcrumb"><a href="/salidas">Salidas</a><span>/</span><%= menor.folio %></nav>
<header class="page-heading"><div><span class="eyebrow">ENTREGA DEL MENOR</span><h1><%= [menor.nombres,menor.apellido_paterno,menor.apellido_materno].filter(Boolean).join(' ') %></h1><p><%= fecha %> · <%= menor.grupo || 'Sin grupo' %> · <%= menor.edad %></p></div><a href="/expedientes/<%= menor.id %>" class="btn btn-outline">Expediente</a></header>
<div class="summary-tags"><span>Entrada: <strong><%= entrada ? 'Registrada a las ' + String(entrada.hora).slice(0,5) : 'Pendiente' %></strong></span><span>Hora actual: <strong><%= hora.slice(0,5) %></strong></span><span>Reportes por retraso: <strong><%= retrasos %></strong></span></div>
<% if(retrasos >= 3) { %><p class="warn-notice">Atención, este menor suma tres o más reportes de retraso. Administración debe revisar el caso.</p><% } %>
<% if(menor.estado === 'baja') { %><p class="warn-notice">El expediente está dado de baja. No se pueden registrar nuevos movimientos.</p><% } else if(!salida) { %>
<section class="surface-card record-section"><h2 class="small-section-title">1. Avisar quién recogerá al menor</h2><p class="form-help">Selecciona una persona ya autorizada en el expediente. Solo administración puede guardar el aviso.</p>
<form method="POST" action="/salidas/<%= menor.id %>/aviso" class="record-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><div><label for="contacto_aviso">Persona anunciada *</label><select name="contacto_id" id="contacto_aviso" required><option value="">Seleccionar persona</option><% contactos.forEach(c => { %><option value="<%= c.id %>" <%= aviso && Number(aviso.contacto_id) === Number(c.id) ? 'selected' : '' %>><%= c.nombre %> · <%= c.parentesco %><%= c.identificacion_entregada ? '' : ' (identificación pendiente)' %></option><% }) %></select></div></div><div class="record-actions"><button type="submit" class="btn btn-primary">Guardar aviso</button></div></form>
<% if(aviso) { %><p class="credencial-info">Persona avisada hoy: <strong><%= aviso.nombre_avisado %></strong>. Puedes cambiar el aviso antes de registrar la salida.</p><% } %>
</section>
<section class="surface-card record-section"><h2 class="small-section-title">2. Registrar salida</h2><p>La persona que se presenta debe ser la misma que se anunció previamente.</p>
<% if(!entrada) { %><p class="warn-notice">Primero debe registrarse la entrada de hoy.</p><% } %>
<% if(!horarioPermitido) { %><p class="warn-notice">La salida se registra a partir de las 15:00 h.</p><% } %>
<% if(retrasoAhora) { %><p class="warn-notice">Ya pasaron las 16:00 h. Si registras la salida ahora se sumará un reporte de retraso.</p><% } %>
<% if(entrada && aviso && horarioPermitido) { %><form method="POST" action="/salidas/<%= menor.id %>" class="record-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><div><label for="contacto_salida">Persona que se presenta *</label><select name="contacto_id" id="contacto_salida" required><option value="">Seleccionar</option><% contactos.forEach(c => { %><option value="<%= c.id %>"><%= c.nombre %></option><% }) %></select><small class="form-help">No se permitirá guardar si no coincide con la persona avisada.</small></div><div class="full-field"><label for="observaciones">Observaciones</label><textarea id="observaciones" name="observaciones" maxlength="500" rows="2" placeholder="Observaciones de la entrega, si las hay"></textarea></div></div><div class="record-actions"><button class="btn btn-primary" type="submit">Confirmar salida</button></div></form><% } %>
</section>
<% } else { %><section class="surface-card record-section"><h2 class="small-section-title">Salida registrada hoy</h2><p>Recogió: <strong><%= salida.nombre_recoge %></strong> · <%= String(salida.hora).slice(0,5) %> · <%= salida.retraso ? 'Con retraso' : 'En horario' %>.</p><% if(salida.observaciones) { %><p><%= salida.observaciones %></p><% } %></section><% } %>
<section class="surface-card"><div class="section-title"><h2 class="small-section-title">Historial de salidas</h2><span class="count-pill"><%= historial.length %></span></div><% if(!historial.length) { %><p class="helper-paragraph">Todavía no existen registros.</p><% } else { %><div class="table-scroll"><table><thead><tr><th>Fecha</th><th>Hora</th><th>Recogió</th><th>Estado</th><th>Registró</th></tr></thead><tbody><% historial.forEach(s => { %><tr><td><%= String(s.fecha).slice(0,10) %></td><td><%= String(s.hora).slice(0,5) %></td><td><%= s.nombre_recoge %></td><td class="<%= s.retraso ? 'text-warning' : 'text-good' %>"><%= s.retraso ? 'Retraso' : 'A tiempo' %></td><td><%= s.responsable || 'Personal' %></td></tr><% }) %></tbody></table></div><% } %></section>
<%- include('partials/page-end') %>
