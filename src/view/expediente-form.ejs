<%- include('partials/page-start', { activePage: 'expedientes' }) %>
<nav class="breadcrumb" aria-label="Ubicación"><a href="/expedientes">Expedientes</a><span>/</span><%= editando ? 'Editar expediente' : 'Nuevo expediente' %></nav>
<header class="page-heading"><div><span class="eyebrow">REGISTRO DE MENORES</span><h1><%= editando ? 'Editar expediente' : 'Nuevo expediente' %></h1><p>Llena la información del niño y de las personas responsables.</p></div><a class="btn btn-outline" href="<%= editando && editando.id ? '/expedientes/' + editando.id : '/expedientes' %>">← Regresar</a></header>
<% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
<form method="POST" action="<%= editando ? '/expedientes/' + editando.id + '/editar' : '/expedientes/nuevo' %>" class="record-form">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<details class="surface-card record-section record-accordion" <%= error || true ? 'open' : '' %>>
<summary class="accordion-header"><span class="accordion-burger" aria-hidden="true">☰</span><span class="accordion-step">01</span><span class="accordion-name">Datos del menor</span><span class="accordion-chevron" aria-hidden="true"></span></summary>
<div class="accordion-content"><p class="accordion-help">Los campos con * son obligatorios.</p>
<div class="form-grid">
<div><label for="nombres">Nombre(s) *</label><input id="nombres" name="nombres" required maxlength="100" value="<%= form.nombres || '' %>" autocomplete="off"></div>
<div><label for="apellido_paterno">Primer apellido *</label><input id="apellido_paterno" name="apellido_paterno" required maxlength="80" value="<%= form.apellido_paterno || '' %>"></div>
<div><label for="apellido_materno">Segundo apellido</label><input id="apellido_materno" name="apellido_materno" maxlength="80" value="<%= form.apellido_materno || '' %>"></div>
<div><label for="fecha_nacimiento">Fecha de nacimiento *</label><input id="fecha_nacimiento" name="fecha_nacimiento" type="date" max="<%= today %>" required value="<%= form.fecha_nacimiento || '' %>"><small class="form-help">Se admiten niños desde un mes cumplido y menores de 4 años.</small></div>
<div><label for="sexo">Sexo</label><select id="sexo" name="sexo"><% [['no_especificado','No especificado'],['femenino','Femenino'],['masculino','Masculino']].forEach(option => { %><option value="<%= option[0] %>" <%= (form.sexo || 'no_especificado') === option[0] ? 'selected' : '' %>><%= option[1] %></option><% }) %></select></div>
<div><label for="fecha_ingreso">Fecha de ingreso (si se conoce)</label><input id="fecha_ingreso" name="fecha_ingreso" type="date" value="<%= form.fecha_ingreso || '' %>"></div>
</div></div></details>
<details class="surface-card record-section record-accordion" <%= error ? 'open' : '' %>>
<summary class="accordion-header"><span class="accordion-burger" aria-hidden="true">☰</span><span class="accordion-step">02</span><span class="accordion-name">Padres o responsables directos</span><span class="accordion-chevron" aria-hidden="true"></span></summary>
<div class="accordion-content"><p class="accordion-help">Debes registrar al menos a la madre o al padre, con su teléfono.</p>
<div class="contact-cards">
<% [['madre','Madre'],['padre','Padre']].forEach(entry => { const tipo=entry[0] %>
<div class="contact-card"><h3><%= entry[1] %></h3><div class="form-grid"><div><label for="<%= tipo %>_nombre">Nombre completo</label><input id="<%= tipo %>_nombre" name="<%= tipo %>_nombre" maxlength="150" value="<%= form[tipo+'_nombre'] || '' %>"></div>
<div><label for="<%= tipo %>_telefono">Teléfono</label><input id="<%= tipo %>_telefono" name="<%= tipo %>_telefono" type="tel" maxlength="20" value="<%= form[tipo+'_telefono'] || '' %>" placeholder="10 dígitos"></div>
<div class="full-field"><label for="<%= tipo %>_correo">Correo (opcional)</label><input id="<%= tipo %>_correo" type="email" name="<%= tipo %>_correo" maxlength="150" value="<%= form[tipo+'_correo'] || '' %>"></div></div>
<label class="check-row"><input type="checkbox" name="<%= tipo %>_recoge" value="1" <%= form[tipo+'_recoge'] ? 'checked' : '' %>> Esta persona puede recoger al menor</label>
<label class="check-row"><input type="checkbox" name="<%= tipo %>_identificacion" value="1" <%= form[tipo+'_identificacion'] ? 'checked' : '' %>> Ya se le entregó identificación para recoger</label>
</div><% }) %></div>
</div></details>
<details class="surface-card record-section record-accordion" <%= error ? 'open' : '' %>>
<summary class="accordion-header"><span class="accordion-burger" aria-hidden="true">☰</span><span class="accordion-step">03</span><span class="accordion-name">Tutores adicionales</span><span class="accordion-chevron" aria-hidden="true"></span></summary>
<div class="accordion-content"><p class="accordion-help">Puedes agregar hasta cuatro. Deja vacíos los espacios que no necesites.</p>
<div class="contact-cards">
<% for (let i=1; i<=4; i++) { const prefix='tutor_'+i %><div class="contact-card"><h3>Tutor <%= i %></h3><div class="form-grid form-grid-three">
<div><label for="<%= prefix %>_nombre">Nombre</label><input id="<%= prefix %>_nombre" name="<%= prefix %>_nombre" maxlength="150" value="<%= form[prefix+'_nombre'] || '' %>"></div>
<div><label for="<%= prefix %>_parentesco">Parentesco</label><input id="<%= prefix %>_parentesco" name="<%= prefix %>_parentesco" maxlength="60" value="<%= form[prefix+'_parentesco'] || '' %>" placeholder="Ej. Tía, abuelo"></div>
<div><label for="<%= prefix %>_telefono">Teléfono</label><input id="<%= prefix %>_telefono" name="<%= prefix %>_telefono" type="tel" maxlength="20" value="<%= form[prefix+'_telefono'] || '' %>"></div></div>
<label class="check-row"><input type="checkbox" name="<%= prefix %>_recoge" value="1" <%= form[prefix+'_recoge'] ? 'checked' : '' %>> También puede recoger al menor</label>
<label class="check-row"><input type="checkbox" name="<%= prefix %>_identificacion" value="1" <%= form[prefix+'_identificacion'] ? 'checked' : '' %>> Identificación entregada</label>
</div><% } %></div></div></details>
<details class="surface-card record-section record-accordion" <%= error ? 'open' : '' %>>
<summary class="accordion-header"><span class="accordion-burger" aria-hidden="true">☰</span><span class="accordion-step">04</span><span class="accordion-name">Otras personas autorizadas</span><span class="accordion-chevron" aria-hidden="true"></span></summary>
<div class="accordion-content"><p class="accordion-help">Personas que pueden recoger al menor aunque no sean sus tutores. Registra su teléfono.</p>
<div class="contact-cards">
<% for (let i=1; i<=4; i++) { const prefix='autorizado_'+i %><div class="contact-card"><h3>Persona autorizada <%= i %></h3><div class="form-grid form-grid-three">
<div><label for="<%= prefix %>_nombre">Nombre</label><input id="<%= prefix %>_nombre" name="<%= prefix %>_nombre" maxlength="150" value="<%= form[prefix+'_nombre'] || '' %>"></div>
<div><label for="<%= prefix %>_parentesco">Relación con el menor</label><input id="<%= prefix %>_parentesco" name="<%= prefix %>_parentesco" maxlength="60" value="<%= form[prefix+'_parentesco'] || '' %>"></div>
<div><label for="<%= prefix %>_telefono">Teléfono</label><input id="<%= prefix %>_telefono" name="<%= prefix %>_telefono" type="tel" maxlength="20" value="<%= form[prefix+'_telefono'] || '' %>"></div>
</div>
<label class="check-row"><input type="checkbox" name="<%= prefix %>_identificacion" value="1" <%= form[prefix+'_identificacion'] ? 'checked' : '' %>> Identificación entregada</label>
</div><% } %></div><p class="form-help">Es obligatorio que al menos uno de los contactos registrados esté autorizado para recoger al menor.</p></div></details>
<details class="surface-card record-section record-accordion" <%= error ? 'open' : '' %>>
<summary class="accordion-header"><span class="accordion-burger" aria-hidden="true">☰</span><span class="accordion-step">05</span><span class="accordion-name">Identificaciones de recogida</span><span class="accordion-chevron" aria-hidden="true"></span></summary>
<div class="accordion-content"><p class="accordion-help">Marca las identificaciones entregadas a cada persona autorizada.</p>
<div class="form-grid"><div><label for="identificaciones_extra">Identificaciones adicionales solicitadas</label><input id="identificaciones_extra" type="number" min="0" max="10" step="1" name="identificaciones_extra" value="<%= form.identificaciones_extra == null ? 0 : form.identificaciones_extra %>"><small class="form-help">Si requieren más identificaciones, anota cuántas están pendientes por entregar.</small></div></div>
<p class="credencial-info">Las identificaciones que falten por entregar se mostrarán en la ficha del menor. La autorización para recoger y la entrega de la identificación se registran por separado. Si cambias el nombre de un contacto existente, su identificación quedará pendiente de nuevo.</p>
</div></details>
<details class="surface-card record-section record-accordion" <%= error ? 'open' : '' %>>
<summary class="accordion-header"><span class="accordion-burger" aria-hidden="true">☰</span><span class="accordion-step">06</span><span class="accordion-name">Cuidados y alimentación</span><span class="accordion-chevron" aria-hidden="true"></span></summary>
<div class="accordion-content"><p class="accordion-help">Escribe los datos importantes para el cuidado diario. Si no aplica, puedes dejarlo vacío.</p>
<div class="form-grid"><div><label for="alergias">Alergias</label><textarea id="alergias" name="alergias" rows="3" maxlength="2000" placeholder="Sustancias, medicamentos, alimentos..."><%= form.alergias || '' %></textarea></div>
<div><label for="restricciones_alimentarias">Restricciones alimentarias</label><textarea id="restricciones_alimentarias" name="restricciones_alimentarias" rows="3" maxlength="2000" placeholder="Alimentos que debe evitar"><%= form.restricciones_alimentarias || '' %></textarea></div>
<div><label for="cuidados_especiales">Cuidados especiales</label><textarea id="cuidados_especiales" name="cuidados_especiales" rows="3" maxlength="2000" placeholder="Indicaciones generales de cuidado"><%= form.cuidados_especiales || '' %></textarea></div>
<div><label for="observaciones">Observaciones</label><textarea id="observaciones" name="observaciones" rows="3" maxlength="2000"><%= form.observaciones || '' %></textarea></div></div></div></details>
<% if (editando) { %>
<details class="surface-card record-section record-accordion" <%= error ? 'open' : '' %>>
<summary class="accordion-header"><span class="accordion-burger" aria-hidden="true">☰</span><span class="accordion-step">07</span><span class="accordion-name">Permanencia hasta verano</span><span class="accordion-chevron" aria-hidden="true"></span></summary>
<div class="accordion-content"><p class="accordion-help">Solo para un menor que ya estaba inscrito y llegó a los cuatro años.</p>
<label class="check-row"><input type="checkbox" name="permanencia_verano" value="1" <%= form.permanencia_verano ? 'checked' : '' %>> Registrar excepción de permanencia</label>
<div class="form-grid"><div><label for="fecha_limite_permanencia">Fecha límite autorizada</label><input type="date" id="fecha_limite_permanencia" name="fecha_limite_permanencia" value="<%= form.fecha_limite_permanencia || '' %>"><small class="form-help">Anota la fecha que indique administración. El documento no fija un día exacto de verano.</small></div></div>
<p class="form-help">Esta opción no permite inscribir niños nuevos que ya hayan cumplido 4 años.</p>
</div></details>
<% } %>
<div class="record-actions"><a class="btn btn-outline" href="<%= editando ? '/expedientes/' + editando.id : '/expedientes' %>">Cancelar</a><button type="submit" class="btn btn-primary"><%= editando ? 'Guardar cambios' : 'Registrar expediente' %></button></div>
</form>
<script>
  document.querySelector('form.record-form')?.addEventListener('invalid', function(event) {
    const panel = event.target.closest('details.record-accordion')
    if (panel) panel.open = true
  }, true)
</script>
<%- include('partials/page-end') %>
