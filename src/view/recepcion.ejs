<%- include('partials/page-start', { activePage: 'recepcion' }) %>
<header class="page-heading"><div><span class="eyebrow">CONTROL DE ENTRADAS</span><h1>Recepción</h1><p><%= fecha %> · Horario vigente: <%= horario.inicio.slice(0,5) %> a <%= horario.fin.slice(0,5) %> h</p></div><a class="btn btn-outline" href="/grupos">Ver grupos</a></header>
<div class="reception-stats"><div class="surface-card"><span class="small-label">ENTRADAS DE LA FECHA</span><strong><%= entradas.length %></strong><p>Entradas del día</p></div><div class="surface-card"><span class="small-label">MENORES VISIBLES</span><strong><%= menores.length %></strong><p><%= admin ? 'De todos los grupos activos' : 'De tus grupos' %></p></div><div class="surface-card"><span class="small-label">HORARIO</span><strong class="schedule-value"><%= horarioAbierto ? 'Abierto' : 'Cerrado' %></strong><p>Hora actual: <%= hora.slice(0,5) %></p></div></div>
<% if (!horarioAbierto) { %><p class="warn-notice">El registro de nuevas entradas está cerrado. El horario permitido es de <%= horario.inicio.slice(0,5) %> a <%= horario.fin.slice(0,5) %> h (hora del centro de México). Puedes consultar los registros existentes.</p><% } %>
<% if (admin) { %><details class="surface-card management-details"><summary>Administrar horario de entrada</summary><p class="form-help">Este cambio afecta las nuevas entradas de todo el personal. Puedes consultar las revisiones antiguas en cualquier momento.</p>
<form method="POST" action="/recepcion/horario"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><div><label for="inicio">Desde</label><input type="time" id="inicio" name="inicio" value="<%= horario.inicio.slice(0,5) %>" required></div><div><label for="fin">Hasta</label><input type="time" id="fin" name="fin" value="<%= horario.fin.slice(0,5) %>" required></div></div><div class="record-actions"><button type="submit" class="btn btn-primary">Guardar horario</button></div></form></details>
<form class="surface-card search-date" method="GET" action="/recepcion"><label for="fecha_recepcion">Consultar revisiones y artículos de otra fecha</label><input id="fecha_recepcion" type="date" name="fecha" value="<%= fecha %>" max="<%= hoy %>"><button class="btn btn-outline" type="submit">Consultar</button><a class="btn btn-text" href="/recepcion">Hoy</a></form><% } %>
<section class="surface-card"><div class="section-title"><div><h2 class="small-section-title">Menores y entradas</h2><p>Selecciona un menor para revisar su registro.</p></div></div>
<% if (!menores.length) { %><div class="empty-state"><h3>No hay menores asignados</h3><p>Revisa la asignación de grupos o registra un expediente nuevo.</p></div><% } else { %>
<div class="table-scroll"><table><thead><tr><th>Menor</th><th>Grupo</th><th>Edad</th><th>Estado</th><th></th></tr></thead><tbody>
<% menores.forEach(m => { %><tr><td><div><b><%= [m.nombres,m.apellido_paterno,m.apellido_materno].filter(Boolean).join(' ') %></b><small class="form-help"><%= m.folio %></small></div></td><td><%= m.grupo_nombre %></td><td><%= m.edad %></td><td><%= m.entrada_id ? 'Entrada ' + String(m.hora).slice(0,5) : 'Sin entrada' %></td><td><a class="inline-link" href="/recepcion/<%= m.id %>"><%= m.entrada_id ? 'Consultar' : 'Registrar / ver' %> →</a></td></tr><% }) %>
</tbody></table></div><% } %>
</section>
<section class="surface-card reception-history"><div class="section-title"><div><h2 class="small-section-title">Entradas registradas el <%= fecha %></h2><p>Revisiones guardadas con fecha y hora.</p></div><span class="count-pill"><%= entradas.length %></span></div>
<% if (!entradas.length) { %><p class="helper-paragraph">No se registraron entradas en la fecha seleccionada.</p><% } else { %>
<div class="table-scroll"><table><thead><tr><th>Hora</th><th>Menor</th><th>Grupo</th><th>Revisión física</th><th></th></tr></thead><tbody>
<% entradas.forEach(e => { %><tr><td><strong><%= String(e.hora).slice(0,5) %></strong></td><td><%= e.nombres %> <%= e.apellido_paterno %></td><td><%= e.grupo_nombre %></td><td><%= e.revision_fisica === 'sin_lesiones' ? 'Sin lesiones visibles' : 'Con observaciones' %></td><td><a class="inline-link" href="/recepcion/<%= e.menor_id %>?fecha=<%= fecha %>">Ver</a></td></tr><% }) %>
</tbody></table></div><% } %>
</section>
<%- include('partials/page-end') %>
