<%- include('partials/page-start', { activePage: 'usuarios' }) %>
<div class="page-heading"><div><h1><%= editando ? 'Editar cuenta' : 'Nuevo usuario' %></h1><p>Completa la información para registrar al personal de la guardería.</p></div><a class="btn btn-outline" href="/usuarios">← Regresar</a></div>
<section class="surface-card form-card">
  <h3>Datos del personal</h3>
  <p class="field-note">Los campos marcados son obligatorios.</p>
  <form action="<%= editando ? '/usuarios/' + editando.id + '/editar' : '/usuarios/nuevo' %>" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-grid">
      <div><label for="nombre">Nombre completo *</label><input id="nombre" name="nombre" type="text" maxlength="100" value="<%= editando ? editando.nombre : '' %>" autocomplete="name" required></div>
      <div><label for="email">Correo electrónico *</label><input id="email" name="email" type="email" maxlength="150" value="<%= editando ? editando.email : '' %>" autocomplete="email" required></div>
      <div><label for="rol">Rol *</label><select id="rol" name="rol" required>
        <% [{value:'administrador',text:'Administrador'},{value:'encargado',text:'Encargado de grupo'},{value:'enfermeria',text:'Enfermería'}].forEach(r => { %>
          <option value="<%= r.value %>" <%= editando && editando.rol === r.value ? 'selected' : '' %>><%= r.text %></option>
        <% }) %>
      </select></div>
      <div><label for="password"><%= editando ? 'Cambiar contraseña (opcional)' : 'Contraseña *' %></label><input id="password" name="password" type="password" minlength="<%= editando ? 0 : 8 %>" maxlength="72" autocomplete="new-password" <%= editando ? '' : 'required' %> placeholder="<%= editando ? 'Vacío para conservar la actual' : 'Al menos 8 caracteres' %>"></div>
    </div>
    <div class="form-actions"><a class="btn btn-outline" href="/usuarios">Cancelar</a><button type="submit" class="btn btn-primary"><%= editando ? 'Guardar cambios' : 'Crear usuario' %></button></div>
  </form>
</section>
<%- include('partials/page-end') %>
