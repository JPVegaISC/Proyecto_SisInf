<%- include('partials/page-start', { activePage: 'salidas' }) %>
<header class="page-heading"><div><span class="eyebrow">CONTROL DE RECOGIDA</span><h1>Salidas</h1><p><%= fecha %> · Salidas de 15:00 a 16:00 h; después se registra un retraso.</p></div><a class="btn btn-outline" href="/expedientes">Ver expedientes</a></header>
<section class="surface-card"><div class="section-title"><div><h2 class="small-section-title">Menores activos</h2><p>Primero se avisa quién recogerá al menor; al salir se verifica que coincida.</p></div><span class="count-pill"><%= menores.length %> menores</span></div>
<% if (!menores.length) { %><p class="helper-paragraph">No hay menores activos con grupo asignado.</p><% } else { %><div class="table-scroll"><table><thead><tr><th>Menor</th><th>Grupo</th><th>Entrada</th><th>Recogida anunciada</th><th>Salida</th><th></th></tr></thead><tbody>
<% menores.forEach(m => { %><tr><td><b><%= [m.nombres,m.apellido_paterno,m.apellido_materno].filter(Boolean).join(' ') %></b><small class="form-help"><%= m.folio %></small></td><td><%= m.grupo %></td><td><%= m.entrada_id ? 'Registrada' : 'Pendiente' %></td><td><%= m.nombre_avisado || 'Sin aviso' %></td><td><% if(m.salida_id) { %><span class="<%= m.retraso ? 'text-warning' : 'text-good' %>"><%= String(m.hora_salida).slice(0,5) %><%= m.retraso ? ' · Retraso' : '' %></span><% } else { %>Pendiente<% } %></td><td><a class="inline-link" href="/salidas/<%= m.id %>">Ver salida →</a></td></tr><% }) %>
</tbody></table></div><% } %></section>
<section class="surface-card reception-history"><h2 class="small-section-title">Últimas salidas</h2><% if(!recientes.length) { %><p class="helper-paragraph">Todavía no hay salidas registradas.</p><% } else { %><div class="table-scroll"><table><thead><tr><th>Fecha</th><th>Menor</th><th>Persona que recogió</th><th>Hora</th><th>Reporte</th></tr></thead><tbody><% recientes.forEach(s => { %><tr><td><%= String(s.fecha).slice(0,10) %></td><td><a href="/salidas/<%= s.menor_id %>"><%= s.nombres %> <%= s.apellido_paterno %></a></td><td><%= s.nombre_recoge %></td><td><%= String(s.hora).slice(0,5) %></td><td><%= s.retraso ? 'Retraso' : 'Sin retraso' %></td></tr><% }) %></tbody></table></div><% } %></section>
<%- include('partials/page-end') %>
