<%- include('partials/page-start', { activePage: 'expedientes' }) %>
<nav class="breadcrumb" aria-label="Ubicación"><a href="/expedientes">Expedientes</a><span>/</span><%= expediente.folio %></nav>
<header class="page-heading"><div><span class="eyebrow">EXPEDIENTE <%= expediente.folio %></span><h1><%= [expediente.nombres, expediente.apellido_paterno, expediente.apellido_materno].filter(Boolean).join(' ') %></h1><p>Ficha general del menor y sus contactos. Estado: <strong><%= expediente.estado === "activo" ? "Activo" : "Baja" %></strong>.</p></div><div class="page-actions"><a class="btn btn-outline" href="/expedientes">← Lista</a><% if (canWrite) { %><a class="btn btn-primary" href="/expedientes/<%= expediente.id %>/editar">Editar expediente</a><% } %></div></header>
<div class="detail-layout"><section class="surface-card"><div class="section-title"><h2 class="small-section-title">Datos del menor</h2><span class="folio-tag"><%= expediente.folio %></span></div><dl class="details-list">
<div><dt>Nombre completo</dt><dd><%= [expediente.nombres, expediente.apellido_paterno, expediente.apellido_materno].filter(Boolean).join(' ') %></dd></div>
<div><dt>Estado del expediente</dt><dd><%= expediente.estado === "activo" ? "Activo" : "Baja" %></dd></div><div><dt>Fecha de nacimiento</dt><dd><%= expediente.fecha_nacimiento %></dd></div><div><dt>Edad</dt><dd><%= expediente.edad %></dd></div>
<div><dt>Sexo</dt><dd><%= ({ femenino:'Femenino', masculino:'Masculino', no_especificado:'No especificado' })[expediente.sexo] %></dd></div>
<div><dt>Fecha de ingreso</dt><dd><%= expediente.fecha_ingreso || 'Sin registrar' %></dd></div>
<% if (expediente.permanencia_verano) { %><div><dt>Permanencia especial hasta</dt><dd><%= expediente.fecha_limite_permanencia || 'No registrada' %></dd></div><% } %>
<div><dt>Última modificación</dt><dd><%= String(expediente.updated_at).slice(0, 16) %></dd></div>
</dl></section>
<section class="surface-card"><h2 class="small-section-title">Cuidados y alimentación</h2><div class="notes-grid"><div><h3>Alergias</h3><p><%= expediente.alergias || 'No se registraron.' %></p></div><div><h3>Restricciones alimentarias</h3><p><%= expediente.restricciones_alimentarias || 'No se registraron.' %></p></div><div><h3>Cuidados especiales</h3><p><%= expediente.cuidados_especiales || 'No se registraron.' %></p></div><div><h3>Observaciones</h3><p><%= expediente.observaciones || 'No hay observaciones.' %></p></div></div></section></div>
<section class="surface-card detail-contacts"><div class="section-title"><div><h2 class="small-section-title">Grupo y recepción</h2><p>Administración puede elegir entre los grupos que correspondan a la edad del menor.</p></div>
<% if (canWrite) { %><a class="btn btn-outline" href="/grupos/menores/<%= expediente.id %>/cambiar">Revisar asignación</a><% } %></div>
<div class="summary-tags"><span>Grupo actual: <strong><%= grupoActual ? grupoActual.nombre : 'Sin asignar' %></strong></span><span>Por edad: <strong><%= grupoSugerido ? grupoSugerido.nombre : 'Revisar permanencia' %></strong></span></div>
<% if (!grupoActual || !grupoSugerido || !grupoValido) { %><p class="warn-notice">La asignación necesita revisión de administración antes de registrar la entrada.</p><% } %>
<% if (usuario.rol === 'administrador' || usuario.rol === 'encargado') { %><a class="inline-link" href="/recepcion/<%= expediente.id %>">Consultar recepción →</a> <a class="inline-link" href="/cuidados/<%= expediente.id %>">Ver bitácora diaria →</a><% } %>
</section>
<section class="surface-card detail-contacts">
<div class="section-title"><div><h2 class="small-section-title">Control de identificaciones</h2><p>Personas autorizadas e identificaciones pendientes.</p></div></div>
<div class="summary-tags"><span>Sin identificación entregada: <strong><%= expediente.credenciales_pendientes %></strong></span><span>Identificaciones adicionales solicitadas: <strong><%= expediente.identificaciones_extra %></strong></span><span>Pendientes en total: <strong><%= expediente.total_identificaciones_pendientes %></strong></span></div>
<% if (expediente.total_identificaciones_pendientes > 0) { %><p class="warn-notice">Hay identificaciones pendientes. Revisa a quién falta entregarlas y si se solicitaron adicionales.</p><% } %>
<div class="section-title"><div><h2 class="small-section-title">Familiares, tutores y personas autorizadas</h2><p><%= expediente.contactos.length %> contactos relacionados con este expediente.</p></div></div><div class="table-scroll"><table><thead><tr><th>Nombre</th><th>Relación</th><th>Teléfono</th><th>Correo</th><th>¿Puede recogerlo?</th><th>Identificación</th></tr></thead><tbody>
<% expediente.contactos.forEach(c => { %><tr><td><b><%= c.nombre %></b></td><td><%= c.parentesco %> <span class="chip"><%= c.tipo === 'tutor' ? 'Tutor adicional' : c.tipo === 'autorizado' ? 'Autorizado' : '' %></span></td><td><%= c.telefono %></td><td><%= c.correo || '—' %></td><td><span class="<%= c.puede_recoger ? 'text-good' : 'text-muted' %>"><%= c.puede_recoger ? 'Sí' : 'No' %></span></td><td><span class="<%= c.identificacion_entregada ? 'text-good' : 'text-warning' %>"><%= c.puede_recoger ? (c.identificacion_entregada ? 'Entregada' : 'Pendiente') : 'No aplica' %></span><% if (c.fecha_entrega_identificacion) { %><small class="form-help"><%= c.fecha_entrega_identificacion %></small><% } %></td></tr><% }) %>
</tbody></table></div><p class="helper-paragraph">Las salidas solo se registran cuando se presenta la persona autorizada y avisada previamente.</p></section>
<section class="surface-card detail-contacts"><div class="section-title"><div><h2 class="small-section-title">Salidas y movimientos</h2><p>Historial de bajas, reinscripciones y reportes.</p></div><span class="count-pill"><%= retrasos %> retrasos</span></div>
<% if (retrasos >= 3) { %><p class="warn-notice">Este expediente tiene al menos tres reportes de retraso.</p><% } %>
<% if (esAdmin) { %><a class="inline-link" href="/salidas/<%= expediente.id %>">Ver salidas y personas autorizadas →</a>
<form method="POST" action="/expedientes/<%= expediente.id %>/estado" class="status-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="accion" value="<%= expediente.estado === 'activo' ? 'baja' : 'reinscripcion' %>"><label for="motivo_estado">Motivo <%= expediente.estado === 'activo' ? 'de la baja' : 'de la reinscripción' %> *</label><textarea name="motivo" id="motivo_estado" rows="2" minlength="5" maxlength="500" required placeholder="Escribe el motivo del movimiento"></textarea><div class="record-actions"><button class="btn <%= expediente.estado === 'activo' ? 'btn-outline' : 'btn-primary' %>" type="submit"><%= expediente.estado === 'activo' ? 'Dar de baja' : 'Reinscribir menor' %></button></div></form>
<% } %>
<% if (!movimientosEstado.length) { %><p class="helper-paragraph">Todavía no hay movimientos de baja o reinscripción.</p><% } else { %><div class="table-scroll"><table><thead><tr><th>Movimiento</th><th>Fecha</th><th>Motivo</th><th>Registró</th></tr></thead><tbody><% movimientosEstado.forEach(m => { %><tr><td><%= m.tipo === 'baja' ? 'Baja' : 'Reinscripción' %></td><td><%= String(m.fecha).slice(0,19) %></td><td><%= m.motivo %></td><td><%= m.responsable || 'Administrador' %></td></tr><% }) %></tbody></table></div><% } %></section>
<%- include('partials/page-end') %>
